  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Основна дія: графіт із золотим кантом.",
      "html": "<button class=\"ds-btn-primary\">Додати в кошик</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 22px;border:0;border-radius:14px;background:#1f1d1b;color:#fbf6ea;font:600 15px/1 Onest,system-ui,sans-serif;letter-spacing:.01em;box-shadow:inset 0 -2px 0 #b08d57;cursor:pointer;transition:transform .15s cubic-bezier(.22,1,.36,1),background-color .2s}.ds-btn-primary:hover{background:#2c2926}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid #b08d57;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Другорядна дія з золотим контуром.",
      "html": "<button class=\"ds-btn-outline\">Відкрити каталог</button>",
      "css": ".ds-btn-outline{min-height:50px;padding:0 22px;border:1px solid #b08d57;border-radius:14px;background:transparent;color:#86683a;font:600 15px/1 Onest,system-ui,sans-serif;cursor:pointer;transition:transform .15s}.ds-btn-outline:active{transform:scale(.97)}.ds-btn-outline:focus-visible{outline:2px solid #b08d57;outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Фільтр; активний заливається графітом.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">Унісекс</button><button class=\"ds-chip is-active\">Для неї</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{height:36px;padding:0 14px;border-radius:999px;border:1px solid #d9cdb9;background:#fff;color:#1f1d1b;font:500 13px Onest,system-ui,sans-serif;cursor:pointer;transition:background-color .36s,color .18s,border-color .36s}.ds-chip.is-active{background:#1f1d1b;border-color:#1f1d1b;color:#fbf6ea}.ds-chip:active{transform:scale(.95)}.ds-chip:focus-visible{outline:2px solid #b08d57;outline-offset:2px}"
    },
    {
      "name": "Volume Switch",
      "kind": "custom",
      "refersTo": "ml-switch-active",
      "description": "Глобальний перемикач 2 / 5 / 10 мл.",
      "html": "<div class=\"ds-ml\"><button>2 мл</button><button class=\"is-active\">5 мл</button><button>10 мл</button></div>",
      "css": ".ds-ml{display:inline-flex;padding:3px;border:1px solid #d9cdb9;border-radius:12px;background:#fff;font-variant-numeric:tabular-nums}.ds-ml button{height:32px;padding:0 10px;border:0;border-radius:9px;background:none;color:#6b645c;font:600 12px Onest,system-ui,sans-serif;cursor:pointer;transition:color .36s,background-color .36s}.ds-ml button.is-active{background:#1f1d1b;color:#fbf6ea;box-shadow:inset 0 -2px 0 #b08d57}.ds-ml button:hover:not(.is-active){color:#1f1d1b}.ds-ml button:focus-visible{outline:2px solid #b08d57;outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Пошук на всю ширину; фокус золотом.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg><input placeholder=\"Бренд, аромат або нота\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;height:48px;padding:0 14px;border-radius:14px;background:#fff;border:1px solid #e8e0d3;color:#9a9289;transition:border-color .2s,box-shadow .2s}.ds-search:focus-within{border-color:#b08d57;box-shadow:0 0 0 3px rgba(176,141,87,.15)}.ds-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:16px Onest,system-ui,sans-serif;color:#1f1d1b;caret-color:#b08d57}"
    },
    {
      "name": "Spectrum Filter",
      "kind": "custom",
      "refersTo": "spectrum",
      "description": "Суцільна смуга дев’яти родин зі шкалою; вибрана — золота рамка.",
      "html": "<div class=\"ds-spec\"><span style=\"background:#8a6a4a\"></span><span style=\"background:#d9a3a0\"></span><span class=\"is-active\" style=\"background:#b8862e\"></span><span style=\"background:#e3c65c\"></span><span style=\"background:#7f8a5c\"></span><span style=\"background:#9c5f2e\"></span><span style=\"background:#b5593a\"></span><span style=\"background:#93aa78\"></span><span style=\"background:#e2d7c4\"></span></div>",
      "css": ".ds-spec{display:flex;gap:1px;width:320px}.ds-spec span{flex:1;height:18px;box-shadow:inset 0 0 0 1px rgba(31,29,27,.07);transition:transform .36s cubic-bezier(.05,.7,.1,1)}.ds-spec span:first-child{border-radius:4px 0 0 4px}.ds-spec span:last-child{border-radius:0 4px 4px 0}.ds-spec span.is-active{transform:scaleY(1.45);box-shadow:0 0 0 1.5px #b08d57;position:relative;z-index:1}.ds-spec span:hover{transform:scaleY(1.2)}"
    },
    {
      "name": "Product Card",
      "kind": "card",
      "refersTo": "product-card",
      "description": "Картка: хроматограма зі шкалою, флакон, назва Forum, ціна табличними цифрами.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card__media\"><span class=\"ds-chroma\"><span style=\"flex:1\"><i style=\"background:#e3c65c\"></i><i style=\"background:#b5593a\"></i></span><span style=\"flex:1.25\"><i style=\"background:#d9a3a0\"></i></span><span style=\"flex:1.5\"><i style=\"background:#8a6a4a\"></i><i style=\"background:#e2d7c4\"></i></span></span></div><div class=\"ds-card__body\"><span class=\"ds-card__brand\">Maison Francis Kurkdjian</span><h3 class=\"ds-card__name\">Baccarat Rouge 540</h3><span class=\"ds-card__meta\"><span>EDP · 5 мл</span><b>1 150 ₴</b></span></div></article>",
      "css": ".ds-card{width:180px;background:#fff;border:1px solid #e8e0d3;border-radius:18px;overflow:hidden;transition:box-shadow .7s cubic-bezier(.05,.7,.1,1),transform .7s cubic-bezier(.05,.7,.1,1)}.ds-card:hover{transform:translateY(-4px);box-shadow:0 2px 4px rgba(43,38,34,.04),0 22px 44px -12px rgba(43,38,34,.2)}.ds-card__media{height:156px;display:flex;padding:14px}.ds-chroma{display:flex;flex-direction:column;gap:3px;width:28px;border-right:1px solid #d9cdb9;padding-right:6px}.ds-chroma>span{display:flex;flex-direction:column;gap:1px}.ds-chroma i{flex:1;border-radius:2px;box-shadow:inset 0 0 0 1px rgba(31,29,27,.07)}.ds-card__body{display:flex;flex-direction:column;gap:1px;padding:12px 12px 14px;border-top:1px solid #e8e0d3;font-family:Onest,system-ui,sans-serif}.ds-card__brand{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#6b645c;font-weight:600}.ds-card__name{margin:0;font:400 20px/1.15 Forum,Georgia,serif;color:#1f1d1b}.ds-card__meta{display:flex;justify-content:space-between;margin-top:6px;font-size:12px;color:#9a9289}.ds-card__meta b{font-size:15px;color:#1f1d1b;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "bottom-nav",
